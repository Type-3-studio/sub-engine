{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowJs": false,
    "checkJs": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@sub-engine/core": ["./packages/core/src/index.ts"],
      "@sub-engine/pixi": ["./packages/pixi/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "games/**/*.ts", "tests/**/*.ts", "packages/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
